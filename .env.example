# Copy this file to `.env` and fill in your values.  NEVER commit .env.
# One file is read by both the React app and the Node server.

# ─── Frontend (bundled into the browser — only PUBLIC values here!) ───────────
# Supabase → Project Settings → API
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key
# Number of reports after which a user can no longer comment (keep same as BLOCK_THRESHOLD)
REACT_APP_BLOCK_THRESHOLD=3
# Only needed if the API server runs on a different domain in production
# REACT_APP_BACKEND_URL=https://your-api.onrender.com
# React dev server port (API uses API_PORT, default 3001)
PORT=3000


# Supabase → Project Settings → API → service_role (secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
BLOCK_THRESHOLD=3

# Optional extras. Without them the multilingual keyword engine still works on its own.
# Our own trained ML model: URL of the Python service (see ml/README.md to train it; `npm run dev` then starts it).
# Leave commented to run with the keyword engine only.
# ML_SERVICE_URL=http://localhost:8000
# Which ML providers to try, in order (default: custom)
# MODERATION_PROVIDERS=custom
# Groq key for AI rewrite suggestions: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b


